# Server
PORT=3000
CLIENT_ORIGINS=http://localhost,http://localhost:8100,http://localhost:8101,http://localhost:8102,http://localhost:4200
APP_JWT_SECRET=replace-with-a-long-random-value

# Xcode Loyalty API. Never place these values in a frontend project.
XCODE_API_BASE_URL=https://xcodeappapi.xcode.com.my/api
XCODE_AUTH_PATH=JWTToken/Post
# Paste the exact JSON body required by JWTToken/Post from your API owner/Swagger.
# Example only - field names must be confirmed before use:
XCODE_AUTH_PAYLOAD={"Username":"your-api-user","Password":"your-api-password"}
